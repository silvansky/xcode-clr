#!/usr/bin/python3
"""xcode-clr — list & delete stale Xcode DerivedData and worktree build/ dirs."""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import plistlib
import shutil
import sqlite3
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor
from contextlib import closing
from dataclasses import dataclass, field
from datetime import datetime, timezone
from pathlib import Path
from typing import Optional

DERIVED_DATA = Path.home() / "Library/Developer/Xcode/DerivedData"
CONFIG_PATH = Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))) / "xcode-clr/config.json"
SKIP_DD_NAMES = {"ModuleCache.noindex", "SDKStatCaches.noindex", "CompilationCache.noindex"}
SIM_CACHE_SUBPATHS = (
    "Library/Caches/com.apple.nsurlsessiond/Downloads",
    "Library/Caches/com.apple.coresymbolicationd",
    "Library/Caches/com.apple.containermanagerd/Dead",
    "tmp",
)
SIM_CACHE_GLOBS = ("Containers/Data/Application/*/Library/Caches", "Containers/Data/Application/*/tmp")
SIM_CACHE_MIN_BYTES = 50 * 1024 * 1024
SIM_WAL_DATABASE = Path("Library/Finance/finance_cloud.db")
SIM_RESET_MIN_BYTES = 2 * 1024 ** 3

USE_COLOR = sys.stdout.isatty() and "NO_COLOR" not in os.environ
ANSI = {"red": "31", "green": "32", "yellow": "33", "magenta": "35", "cyan": "36"}
KIND_COLORS = {"derived_data": "cyan", "worktree_build": "green", "simulator": "magenta", "simulator_cache": "yellow", "simulator_wal": "yellow"}


def color(s: str, name: Optional[str]) -> str:
    if not USE_COLOR or not name:
        return s
    return f"\033[{ANSI[name]}m{s}\033[0m"


@dataclass
class Entry:
    path: Path
    kind: str
    source_path: Optional[Path]
    mtime: datetime
    last_accessed: Optional[datetime] = None
    size_bytes: int = 0
    reason: Optional[str] = None
    udid: Optional[str] = None       # simulator only
    state: Optional[str] = None      # simulator only: Booted | Shutdown | ...
    available: bool = True           # simulator only: runtime still installed
    label: Optional[str] = None      # display name shown instead of source_path
    local_packages: list[Path] = field(default_factory=list)  # derived_data only: local SwiftPM deps
    purge_paths: list[Path] = field(default_factory=list)     # simulator_cache only: dirs whose contents get cleared
    shutdown_idle: bool = False
    idle_blocker: Optional[str] = None
    reset_idle: bool = False

    @property
    def oversized_simulator(self) -> bool:
        return self.kind == "simulator" and self.size_bytes > SIM_RESET_MIN_BYTES

    @property
    def requires_shutdown(self) -> bool:
        return (self.kind in ("simulator_cache", "simulator_wal") or self.reset_idle) and self.state != "Shutdown"

    @property
    def staleness_ts(self) -> datetime:
        if self.kind in ("simulator", "simulator_cache", "simulator_wal"):
            return self.last_accessed or self.mtime  # last simulator activity, else folder mtime
        return max(self.mtime, self.last_accessed) if self.last_accessed else self.mtime

    def age_days(self, now: datetime) -> float:
        return (now - self.staleness_ts).total_seconds() / 86400.0


def folder_hash(folder: Path) -> Optional[str]:
    h = folder.name.rsplit("-", 1)[-1]
    return h if len(h) == 28 and h.isascii() and h.isalpha() and h.islower() else None


def derived_data_hash(target: Path) -> str:
    digest = hashlib.md5(str(target).encode()).digest()
    out = ""
    for half in (digest[:8], digest[8:]):
        v = int.from_bytes(half, "big")
        chars = []
        for _ in range(14):
            chars.append(chr(ord("a") + v % 26))
            v //= 26
        out += "".join(reversed(chars))
    return out


def read_info_plist(folder: Path) -> tuple[Optional[Path], Optional[datetime]]:
    plist = folder / "info.plist"
    if not plist.is_file():
        return None, None
    try:
        with plist.open("rb") as f:
            data = plistlib.load(f)
    except Exception:
        return None, None
    workspace = data.get("WorkspacePath")
    last_accessed = data.get("LastAccessedDate")
    if not isinstance(last_accessed, datetime):
        last_accessed = None
    elif last_accessed.tzinfo is None:
        last_accessed = last_accessed.replace(tzinfo=timezone.utc)
    return (Path(workspace) if workspace else None), last_accessed


def local_package_paths(folder: Path) -> list[Path]:
    state = folder / "SourcePackages/workspace-state.json"
    try:
        with state.open() as f:
            deps = json.load(f)["object"]["dependencies"]
    except (OSError, ValueError, KeyError, TypeError):
        return []
    paths: list[Path] = []
    for dep in deps:
        loc = (dep.get("packageRef") or {}).get("location", "")
        if isinstance(loc, str) and loc.startswith("/"):
            paths.append(Path(loc))
    return paths


def last_activity(folder: Path) -> datetime:
    ts = folder.stat().st_mtime
    for manifest in folder.glob("Logs/*/LogStoreManifest.plist"):
        ts = max(ts, manifest.stat().st_mtime)
    return datetime.fromtimestamp(ts, tz=timezone.utc)


def find_derived_data() -> list[Entry]:
    if not DERIVED_DATA.is_dir():
        return []
    entries: list[Entry] = []
    for child in DERIVED_DATA.iterdir():
        if not child.is_dir() or child.name in SKIP_DD_NAMES or child.name.endswith(".noindex"):
            continue
        workspace, last_accessed = read_info_plist(child)
        if workspace is None and folder_hash(child) is None:
            continue
        entries.append(Entry(
            path=child,
            kind="derived_data",
            source_path=workspace,
            mtime=last_activity(child),
            last_accessed=last_accessed,
            local_packages=local_package_paths(child),
        ))
    return entries


def xcodebuild_targets(worktree: Path) -> list[Path]:
    """Paths xcodebuild may have been pointed at: workspaces, projects, package dirs."""
    try:
        targets = [p for p in worktree.iterdir() if p.suffix in (".xcworkspace", ".xcodeproj")]
    except OSError:
        return []
    for pattern in ("Package.swift", "*/Package.swift", "*/*/Package.swift"):
        targets += [m.parent for m in worktree.glob(pattern)]
    return targets


def resolve_derived_sources(derived: list[Entry], worktrees: list[Path]) -> None:
    unresolved = [e for e in derived if e.source_path is None]
    if not unresolved:
        return
    by_hash = {derived_data_hash(t): t for wt in worktrees for t in xcodebuild_targets(wt)}
    for e in unresolved:
        e.source_path = by_hash.get(folder_hash(e.path))


def git_worktree_paths(root: Path) -> list[Path]:
    if not root.is_dir():
        return []
    try:
        out = subprocess.run(
            ["git", "-C", str(root), "worktree", "list", "--porcelain"],
            capture_output=True, text=True, check=True,
        ).stdout
    except (subprocess.CalledProcessError, FileNotFoundError):
        return []
    paths: list[Path] = []
    for line in out.splitlines():
        if line.startswith("worktree "):
            paths.append(Path(line[len("worktree "):]))
    return paths


def find_git_root(start: Path) -> Optional[Path]:
    for p in [start, *start.parents]:
        if (p / ".git").exists():
            return p
    return None


def resolve_worktree_roots(
    derived: list[Entry],
    explicit: list[Path],
    auto: bool,
) -> list[Path]:
    seen: set[Path] = set()
    roots: list[Path] = []

    def add(p: Path) -> None:
        try:
            r = p.resolve()
        except OSError:
            return
        if r in seen or not r.is_dir():
            return
        seen.add(r)
        roots.append(r)

    for p in explicit:
        add(p)
    if auto:
        for e in derived:
            hints = [e.source_path] if e.source_path else []
            for hint in hints + e.local_packages:
                if hint.exists():
                    gr = find_git_root(hint)
                    if gr:
                        add(gr)
    return roots


def list_worktrees(roots: list[Path]) -> list[Path]:
    seen: set[Path] = set()
    worktrees: list[Path] = []
    for root in roots:
        for wt in git_worktree_paths(root):
            try:
                key = wt.resolve()
            except OSError:
                continue
            if key not in seen:
                seen.add(key)
                worktrees.append(wt)
    return worktrees


def find_stale_builds(worktrees: list[Path]) -> list[Entry]:
    entries: list[Entry] = []
    for wt in worktrees:
        build = wt / "build"
        if not build.is_dir():
            continue
        mtime = datetime.fromtimestamp(build.stat().st_mtime, tz=timezone.utc)
        entries.append(Entry(path=build, kind="worktree_build", source_path=wt, mtime=mtime))
    return entries


def parse_iso(s: Optional[str]) -> Optional[datetime]:
    if not s:
        return None
    try:
        dt = datetime.fromisoformat(s.replace("Z", "+00:00"))
        return dt.replace(tzinfo=timezone.utc) if dt.tzinfo is None else dt.astimezone(timezone.utc)
    except ValueError:
        return None


def simulator_last_activity(device: dict) -> Optional[datetime]:
    # Xcode 26.x reports lastBootedAt; Xcode 27 reports lastUsedAt.
    # Prefer the latest activity if both fields are present.
    timestamps = [parse_iso(device.get(key)) for key in ("lastBootedAt", "lastUsedAt")]
    return max((ts for ts in timestamps if ts is not None), default=None)


def runtime_label(runtime_id: str) -> str:
    tail = runtime_id.rsplit(".", 1)[-1]  # iOS-18-6
    parts = tail.split("-")
    return f"{parts[0]} {'.'.join(parts[1:])}" if len(parts) > 1 else tail


def simctl_devices() -> dict:
    try:
        out = subprocess.run(
            ["xcrun", "simctl", "list", "devices", "--json"],
            capture_output=True, text=True, check=True,
        ).stdout
    except (subprocess.CalledProcessError, FileNotFoundError):
        return {}
    try:
        return json.loads(out).get("devices", {})
    except ValueError:
        return {}


def iter_devices(devices: dict):
    for runtime_id, devs in devices.items():
        rt = runtime_label(runtime_id)
        for d in devs:
            if d.get("udid") and d.get("dataPath"):
                yield rt, d


def find_simulators(devices: dict) -> list[Entry]:
    entries: list[Entry] = []
    for rt, d in iter_devices(devices):
        udid = d["udid"]
        device_dir = Path(d["dataPath"]).parent
        last_used = simulator_last_activity(d)
        try:
            mtime = datetime.fromtimestamp(device_dir.stat().st_mtime, tz=timezone.utc)
        except OSError:
            if last_used is None:
                continue
            mtime = last_used
        state = d.get("state")
        name = d.get("name") or udid
        tags = [t for t in (rt, None if state == "Shutdown" else state) if t]
        entries.append(Entry(
            path=device_dir,
            kind="simulator",
            source_path=None,
            mtime=mtime,
            last_accessed=last_used,
            size_bytes=int(d.get("dataPathSize") or 0),
            udid=udid,
            state=state,
            available=bool(d.get("isAvailable")),
            label=f"{name} · {' · '.join(tags)}",
        ))
    return entries


def sim_cache_paths(data_dir: Path) -> list[Path]:
    paths = [data_dir / sub for sub in SIM_CACHE_SUBPATHS]
    for pattern in SIM_CACHE_GLOBS:
        paths += data_dir.glob(pattern)
    return [p for p in paths if p.is_dir()]


def find_simulator_caches(devices: dict) -> list[Entry]:
    entries: list[Entry] = []
    for rt, d in iter_devices(devices):
        last_used = simulator_last_activity(d)
        if not d.get("isAvailable") or last_used is None:
            continue
        data_dir = Path(d["dataPath"])
        purge = sim_cache_paths(data_dir)
        if not purge:
            continue
        entries.append(Entry(
            path=data_dir,
            kind="simulator_cache",
            source_path=None,
            mtime=last_used,
            last_accessed=last_used,
            udid=d["udid"],
            state=d.get("state"),
            label=f"{d.get('name') or d['udid']} · {rt} · caches · {d.get('state') or 'unknown'}",
            purge_paths=purge,
        ))
    return entries


def device_states() -> dict[str, str]:
    return {d["udid"]: d.get("state") for _, d in iter_devices(simctl_devices())}


def find_simulator_wals(devices: dict) -> list[Entry]:
    entries: list[Entry] = []
    for rt, d in iter_devices(devices):
        last_used = simulator_last_activity(d)
        if not d.get("isAvailable") or last_used is None:
            continue
        database = Path(d["dataPath"]) / SIM_WAL_DATABASE
        wal = database.with_name(database.name + "-wal")
        if not database.is_file() or not wal.is_file():
            continue
        entries.append(Entry(
            path=wal,
            kind="simulator_wal",
            source_path=database,
            mtime=last_used,
            last_accessed=last_used,
            udid=d["udid"],
            state=d.get("state"),
            label=f"{d.get('name') or d['udid']} · {rt} · Finance WAL · {d.get('state') or 'unknown'}",
        ))
    return entries


def source_missing(e: Entry) -> bool:
    if e.source_path:
        return not e.source_path.exists()
    return bool(e.local_packages) and not any(p.exists() for p in e.local_packages)


def simulator_idle_blocker(device: dict, minutes: int, now: datetime,
                           allow_shutdown: bool = False) -> Optional[str]:
    if device.get("state") not in (("Booted", "Shutdown") if allow_shutdown else ("Booted",)):
        return f"device is {device.get('state') or 'unknown'}"
    last_used = simulator_last_activity(device)
    cutoff = now.timestamp() - minutes * 60
    if last_used is None or last_used.timestamp() > cutoff:
        return "recent or unknown simulator activity"
    try:
        processes = subprocess.run(["ps", "-axo", "comm="], capture_output=True,
                                   text=True, check=True, timeout=10).stdout
        if not processes.strip():
            return "empty process inventory"
        for process in processes.splitlines():
            name = Path(process.strip()).name.lower()
            if name in ("xcodebuild", "xctest", "xctrunner") or name.endswith("-runner"):
                return "test/build runner active on host"
            if f"/{device['udid']}/data/Containers/" in process:
                return "app process running"
        if device.get("state") == "Booted":
            jobs = subprocess.run(["xcrun", "simctl", "spawn", device["udid"], "launchctl", "list"],
                                  capture_output=True, text=True, check=True, timeout=10).stdout
            if not jobs.startswith("PID"):
                return "unrecognized process inventory"
            for line in jobs.splitlines()[1:]:
                fields = line.split(None, 2)
                if len(fields) != 3:
                    return "unrecognized process inventory"
                pid, _, label = fields
                if not pid.isdigit():
                    continue
                passive = label.startswith(("UIKitApplication:com.apple.Spotlight[",
                                            "UIKitApplication:com.apple.chrono.WidgetRenderer-"))
                if (label.startswith("UIKitApplication:") and not passive) or "xctest" in label.lower():
                    return f"app/test running: {label}"
        data_dir = Path(device["dataPath"])
        if not data_dir.is_dir():
            return "device data missing"
        for subpath in ("Containers/Data/Application", "Containers/Shared/AppGroup", "Containers/Bundle/Application"):
            root = data_dir / subpath
            if not root.exists():
                continue
            def fail(error):
                raise error
            for directory, dirs, files in os.walk(root, onerror=fail):
                for path in [Path(directory), *(Path(directory) / name for name in dirs + files)]:
                    stat = path.lstat()
                    if max(stat.st_mtime, stat.st_ctime) > cutoff:
                        return f"app-container activity within {minutes} minutes"
    except (OSError, subprocess.SubprocessError) as ex:
        return f"activity check failed: {ex}"
    return None


def shutdown_idle_simulator(udid: str, minutes: int) -> None:
    device = next((d for _, d in iter_devices(simctl_devices()) if d["udid"] == udid), None)
    if device is None:
        raise RuntimeError("device missing")
    if device.get("state") == "Shutdown":
        return
    blocker = simulator_idle_blocker(device, minutes, datetime.now(timezone.utc))
    if blocker:
        raise RuntimeError(f"not idle: {blocker}")
    subprocess.run(["xcrun", "simctl", "shutdown", udid], capture_output=True,
                   text=True, check=True, timeout=30)
    if device_states().get(udid) != "Shutdown":
        raise RuntimeError("shutdown not confirmed; cleanup skipped")
    print(f"  shut down {device.get('name') or udid}")


def prepare_simulator_resets(entries: list[Entry], devices: dict, minutes: int, now: datetime) -> None:
    by_udid = {d["udid"]: d for _, d in iter_devices(devices)}
    for e in entries:
        if not e.oversized_simulator or not e.available:
            continue
        # An explicit reset request replaces deletion for these devices, even if blocked.
        e.reason = None
        device = by_udid.get(e.udid)
        e.idle_blocker = (simulator_idle_blocker(device, minutes, now, allow_shutdown=True)
                          if device else "device missing")
        e.reset_idle = e.idle_blocker is None


def reset_idle_simulator(udid: str, minutes: int) -> int:
    def checked_device() -> dict:
        device = next((d for _, d in iter_devices(simctl_devices()) if d["udid"] == udid), None)
        if device is None or not device.get("isAvailable"):
            raise RuntimeError("device missing or runtime unavailable")
        blocker = simulator_idle_blocker(device, minutes, datetime.now(timezone.utc), allow_shutdown=True)
        if blocker:
            raise RuntimeError(f"not idle: {blocker}")
        return device

    device = checked_device()
    if device.get("state") == "Booted":
        shutdown_idle_simulator(udid, minutes)
        device = checked_device()
    path = Path(device["dataPath"]).parent
    before = du_bytes([path])
    if device.get("state") != "Shutdown" or device_states().get(udid) != "Shutdown":
        raise RuntimeError("shutdown not confirmed; reset skipped")
    subprocess.run(["xcrun", "simctl", "erase", udid], capture_output=True,
                   text=True, check=True, timeout=120)
    return max(0, before - du_bytes([path]))


def mark_stale(entries: list[Entry], days: int, sim_days: int, now: datetime) -> None:
    for e in entries:
        if e.kind == "simulator_wal":
            e.reason = "checkpoint" if e.state == "Shutdown" else None
            continue
        if e.kind == "simulator_cache":
            e.reason = "purgeable" if e.state == "Shutdown" else None
            continue
        if e.kind == "simulator":
            if not e.available:
                e.reason = "runtime unavailable"
            elif e.state != "Shutdown":
                pass  # booted / in use — never delete
            elif e.last_accessed is None:
                pass  # never booted — leave default templates alone
            elif e.age_days(now) > sim_days:
                e.reason = f"stale >{sim_days}d"
            continue
        if e.kind == "derived_data" and source_missing(e):
            e.reason = "source missing"
            continue
        if e.age_days(now) > days:
            e.reason = f"stale >{days}d"


def du_bytes(paths: list[Path]) -> int:
    if not paths:
        return 0
    try:
        out = subprocess.run(
            ["du", "-sk", *map(str, paths)],
            capture_output=True, text=True,
        ).stdout
    except FileNotFoundError:
        return 0
    total = 0
    for line in out.splitlines():
        try:
            total += int(line.split()[0])
        except (ValueError, IndexError):
            continue
    return total * 1024


def compute_sizes(entries: list[Entry]) -> None:
    todo = [e for e in entries if not e.size_bytes]  # simulators carry dataPathSize already
    if not todo:
        return
    with ThreadPoolExecutor(max_workers=8) as ex:
        sizes = list(ex.map(du_bytes, [e.purge_paths or [e.path] for e in todo]))
    for e, s in zip(todo, sizes):
        e.size_bytes = s


def human_size(n: int) -> str:
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1024 or unit == "TB":
            return f"{n:.1f} {unit}" if unit != "B" else f"{n} B"
        n /= 1024
    return f"{n:.1f} TB"


def truncate_left(s: str, width: int) -> str:
    if len(s) <= width:
        return s
    return "..." + s[-(width - 3):]


def short_path(p: Optional[Path]) -> str:
    if p is None:
        return "-"
    s = str(p)
    home = str(Path.home())
    if s.startswith(home):
        s = "~" + s[len(home):]
    return s


def render_table(entries: list[Entry], now: datetime, numbered: bool = False) -> str:
    if not entries:
        return ""
    header = ("SIZE", "AGE", "REASON", "KIND", "SOURCE", "PATH")
    head = (("#",) + header) if numbered else header
    rows = [head]
    colors = [(None,) * len(head)]
    for i, e in enumerate(entries, 1):
        row = (
            human_size(e.size_bytes),
            f"{e.age_days(now):.1f}d",
            ("shutdown + reset" if e.requires_shutdown else "reset") if e.reset_idle else
            e.reason or ("shutdown + clean" if e.shutdown_idle else "shutdown required" if e.requires_shutdown else "-"),
            e.kind,
            truncate_left(e.label or short_path(e.source_path), 70),
            truncate_left(short_path(e.path), 70),
        )
        cc = ("red", None, None, KIND_COLORS.get(e.kind), None, None)
        rows.append(((str(i),) + row) if numbered else row)
        colors.append(((None,) + cc) if numbered else cc)
    widths = [max(len(r[i]) for r in rows) for i in range(len(rows[0]))]
    lines = []
    for r, cc in zip(rows, colors):
        lines.append("  ".join(color(c.ljust(widths[i]), cc[i]) for i, c in enumerate(r)))
    return "\n".join(lines)


def disk_usage() -> tuple[int, int]:
    u = shutil.disk_usage(Path.home())
    return u.free, u.total


def render_json(entries: list[Entry], threshold_days: int, sim_threshold_days: int, now: datetime) -> str:
    def iso(dt: Optional[datetime]) -> Optional[str]:
        return dt.astimezone(timezone.utc).isoformat().replace("+00:00", "Z") if dt else None

    items = []
    for e in entries:
        item = {
            "path": str(e.path),
            "kind": e.kind,
            "source_path": str(e.source_path) if e.source_path else None,
            "size_bytes": e.size_bytes,
            "last_accessed": iso(e.last_accessed),
            "mtime": iso(e.mtime),
            "age_days": round(e.age_days(now), 2),
            "reason": e.reason,
            "to_be_removed": e.reason is not None,
        }
        if e.kind in ("simulator", "simulator_cache", "simulator_wal"):
            item.update(name=e.label, udid=e.udid, state=e.state, available=e.available)
        if e.kind == "simulator":
            item.update(oversized=e.oversized_simulator, to_be_reset=e.reset_idle,
                        requires_shutdown=e.requires_shutdown, idle_blocker=e.idle_blocker,
                        action="reset" if e.reset_idle else "delete" if e.reason else None)
        if e.kind in ("simulator_cache", "simulator_wal"):
            item.update(requires_shutdown=e.requires_shutdown, shutdown_then_clean=e.shutdown_idle,
                        idle_blocker=e.idle_blocker)
        if e.kind == "simulator_wal":
            item["action"] = "checkpoint"
        if e.kind == "simulator_cache":
            item["purge_paths"] = [str(p) for p in e.purge_paths]
        items.append(item)
    free, total = disk_usage()
    return json.dumps({
        "scanned_at": iso(now),
        "threshold_days": threshold_days,
        "simulator_threshold_days": sim_threshold_days,
        "after_shutdown_bytes": total_size([e for e in entries if e.requires_shutdown]),
        "simulator_reset_threshold_bytes": SIM_RESET_MIN_BYTES,
        "disk": {"free_bytes": free, "total_bytes": total, "used_bytes": total - free},
        "items": items,
    }, indent=2)


def parse_selection(s: str, n: int) -> Optional[set[int]]:
    """Parse "1,3,5-7" into a set of 0-based indices in [0, n). None on syntax error."""
    out: set[int] = set()
    for tok in s.replace(" ", "").split(","):
        if not tok:
            continue
        if "-" in tok:
            a, _, b = tok.partition("-")
            if not (a.isdigit() and b.isdigit()):
                return None
            lo, hi = sorted((int(a), int(b)))
        elif tok.isdigit():
            lo = hi = int(tok)
        else:
            return None
        out.update(i - 1 for i in range(lo, hi + 1) if 1 <= i <= n)
    return out


def clear_dir(d: Path) -> None:
    for child in d.iterdir():
        if child.is_dir() and not child.is_symlink():
            shutil.rmtree(child)
        else:
            child.unlink()


def checkpoint_wal(database: Path) -> int:
    paths = [database.with_name(database.name + suffix) for suffix in ("", "-wal", "-shm")]
    if any(p.is_symlink() for p in paths):
        raise RuntimeError("database or WAL sidecar is a symlink, skipped")
    before = du_bytes(paths)
    with closing(sqlite3.connect(database.absolute().as_uri() + "?mode=rw", uri=True, timeout=0)) as db:
        result = db.execute("PRAGMA wal_checkpoint(TRUNCATE)").fetchone()
        if result != (0, 0, 0):
            raise RuntimeError("WAL checkpoint incomplete or database busy")
    return max(0, before - du_bytes(paths))


def delete_entries(entries: list[Entry], idle_minutes: Optional[int] = None) -> int:
    freed = 0
    removed_simulators: set[str] = set()
    shutdown_attempted: dict[str, Optional[str]] = {}
    for e in sorted(entries, key=lambda e: e.kind != "simulator"):
        if e.kind in ("simulator_cache", "simulator_wal") and e.udid in removed_simulators:
            continue
        try:
            if e.kind == "simulator" and e.reset_idle:
                removed_simulators.add(e.udid)  # reset covers caches/WALs, even on failure
                if idle_minutes is None:
                    raise RuntimeError("idle threshold required, reset skipped")
                reclaimed = reset_idle_simulator(e.udid, idle_minutes)
                freed += reclaimed
                print(f"  reset {e.label or e.path} ({human_size(reclaimed)} freed)")
                continue
            if e.requires_shutdown:
                if not e.shutdown_idle or idle_minutes is None:
                    raise RuntimeError("shutdown required, skipped")
                if e.udid not in shutdown_attempted:
                    try:
                        shutdown_idle_simulator(e.udid, idle_minutes)
                        shutdown_attempted[e.udid] = None
                    except Exception as ex:
                        shutdown_attempted[e.udid] = str(ex)
                if shutdown_attempted[e.udid]:
                    raise RuntimeError(shutdown_attempted[e.udid])
            if e.kind == "simulator_wal":
                state = device_states().get(e.udid)
                if state != "Shutdown":
                    raise RuntimeError(f"device is {state or 'gone'}, skipped")
                reclaimed = checkpoint_wal(e.source_path)
                freed += reclaimed
                print(f"  checkpointed {e.label or e.path} ({human_size(reclaimed)} freed)")
                continue
            if e.kind == "simulator":
                r = subprocess.run(
                    ["xcrun", "simctl", "delete", e.udid],
                    capture_output=True, text=True,
                )
                if r.returncode != 0:
                    raise RuntimeError(r.stderr.strip() or f"simctl exit {r.returncode}")
                removed_simulators.add(e.udid)
            elif e.kind == "simulator_cache":
                state = device_states().get(e.udid)
                if state != "Shutdown":
                    raise RuntimeError(f"device is {state or 'gone'}, skipped")
                for d in e.purge_paths:
                    clear_dir(d)
            else:
                shutil.rmtree(e.path)
            freed += e.size_bytes
            print(f"  removed {e.label or e.path} ({human_size(e.size_bytes)})")
        except Exception as ex:
            print(f"  FAILED {e.label or e.path}: {ex}", file=sys.stderr)
    return freed


def total_size(entries: list[Entry]) -> int:
    simulators = {e.udid for e in entries if e.kind == "simulator"}
    return sum(e.size_bytes for e in entries
               if e.kind not in ("simulator_cache", "simulator_wal") or e.udid not in simulators)


def load_config() -> dict:
    if not CONFIG_PATH.is_file():
        return {}
    try:
        with CONFIG_PATH.open() as f:
            return json.load(f)
    except (OSError, ValueError) as ex:
        print(f"warning: ignoring {CONFIG_PATH}: {ex}", file=sys.stderr)
        return {}


def env_worktree_roots() -> list[Path]:
    raw = os.environ.get("XCODE_CLR_WORKTREE_ROOTS", "")
    return [Path(p).expanduser() for p in raw.split(":") if p]


def main() -> int:
    cfg = load_config()
    cfg_roots = [Path(p).expanduser() for p in cfg.get("worktree_roots", [])]
    cfg_days = int(cfg.get("threshold_days", 2))
    cfg_auto = bool(cfg.get("auto_discover", True))
    cfg_sims = bool(cfg.get("scan_simulators", True))
    cfg_sim_days = int(cfg.get("simulator_threshold_days", 3))
    cfg_sim_caches = bool(cfg.get("scan_simulator_caches", True))
    cfg_sim_wals = bool(cfg.get("scan_simulator_wals", True))

    p = argparse.ArgumentParser(
        description="Clean Xcode DerivedData, worktree build/ dirs, unused simulators, caches and Finance WALs.")
    p.add_argument("--dry-run", action="store_true", help="list only, never delete")
    p.add_argument("--json", action="store_true", help="emit JSON (implies no delete)")
    p.add_argument("--yes", "-y", action="store_true", help="skip confirmation prompt")
    p.add_argument("--days", type=int, default=cfg_days,
                   help=f"staleness threshold in days (default {cfg_days})")
    p.add_argument("--simulator-days", type=int, default=cfg_sim_days,
                   help=f"simulator staleness threshold in days (default {cfg_sim_days})")
    p.add_argument("--worktree-root", type=Path, action="append", default=[],
                   metavar="PATH",
                   help="extra git worktree root to scan; repeatable")
    p.add_argument("--no-auto", dest="auto", action="store_false", default=cfg_auto,
                   help="disable auto-discovery of worktree roots from DerivedData")
    p.add_argument("--no-simulators", dest="simulators", action="store_false", default=cfg_sims,
                   help="skip scanning iOS Simulator devices")
    p.add_argument("--no-simulator-caches", dest="simulator_caches", action="store_false",
                   default=cfg_sim_caches,
                   help="skip purgeable caches inside shut-down simulators")
    p.add_argument("--all", action="store_true", help="list every folder found, not only stale")
    p.add_argument("--no-simulator-wals", dest="simulator_wals", action="store_false",
                   default=cfg_sim_wals, help="skip Finance database WAL checkpointing")
    p.add_argument("--shutdown-idle", action="store_true", help="offer shutdown and cache/WAL cleanup for idle simulators")
    p.add_argument("--idle-minutes", type=int, default=30, help="minimum app inactivity before shutdown/reset (default 30)")
    p.add_argument("--reset-idle", action="store_true",
                   help="offer reset of idle simulators over 2 GB; erases all apps, data and settings")
    args = p.parse_args()
    if args.idle_minutes < 1:
        p.error("--idle-minutes must be at least 1")

    now = datetime.now(timezone.utc)
    derived = find_derived_data()
    roots = resolve_worktree_roots(
        derived,
        explicit=cfg_roots + env_worktree_roots() + args.worktree_root,
        auto=args.auto,
    )
    worktrees = list_worktrees(roots)
    resolve_derived_sources(derived, worktrees)
    entries = derived + find_stale_builds(worktrees)
    devices = {}
    if args.simulators or args.simulator_caches or args.simulator_wals:
        devices = simctl_devices()
        if args.simulators:
            entries += find_simulators(devices)
        if args.simulator_caches:
            entries += find_simulator_caches(devices)
        if args.simulator_wals:
            entries += find_simulator_wals(devices)
    mark_stale(entries, args.days, args.simulator_days, now)
    compute_sizes(entries)
    entries = [e for e in entries if e.kind not in ("simulator_cache", "simulator_wal") or e.size_bytes >= SIM_CACHE_MIN_BYTES]
    entries.sort(key=lambda e: (e.reason is None, -e.size_bytes))
    if args.shutdown_idle:
        blockers = {d["udid"]: simulator_idle_blocker(d, args.idle_minutes, now)
                    for _, d in iter_devices(devices)
                    if any(e.udid == d["udid"] and e.requires_shutdown for e in entries)}
        for e in entries:
            if e.requires_shutdown:
                e.idle_blocker = blockers.get(e.udid, "device missing")
                e.shutdown_idle = e.idle_blocker is None
    if args.reset_idle:
        prepare_simulator_resets(entries, devices, args.idle_minutes, now)

    if args.json:
        print(render_json(entries, args.days, args.simulator_days, now))
        return 0

    reset_udids = {e.udid for e in entries if e.reset_idle}
    stale = [e for e in entries if (e.reason or e.shutdown_idle or e.reset_idle)
             and not (e.kind in ("simulator_cache", "simulator_wal") and e.udid in reset_udids)]
    total = total_size(stale)

    free, total_disk = disk_usage()
    disk_line = f"Disk: {human_size(free)} free of {human_size(total_disk)}"
    interactive = bool(stale) and not args.dry_run and not args.yes
    large = [e for e in entries if e.oversized_simulator]
    if large:
        print("Warning: simulators over 2 GB. Reset erases ALL installed apps, app data and settings.")
        print(render_table(large, now))
        print("Use --reset-idle to offer reset of idle devices (default 30 minutes; --idle-minutes N).")
        print("Reset sizes are estimates; system assets may download again.")
        if args.reset_idle:
            for e in large:
                if e.idle_blocker or not e.available:
                    print(f"  {e.udid}: reset skipped — {e.idle_blocker or 'runtime unavailable'}")
        print()
    blocked = [e for e in entries if e.kind in ("simulator_cache", "simulator_wal") and e.requires_shutdown
               and e.udid not in reset_udids]
    if blocked:
        print("Available after simulator shutdown (estimated):")
        print(render_table(blocked, now))
        print(f"\nAfter shutdown: {human_size(total_size(blocked))}. "
              "Use --shutdown-idle to offer shutdown and cleanup of idle devices.")
        if args.shutdown_idle:
            for udid, blocker in blockers.items():
                if blocker:
                    print(f"  {udid}: skipped — {blocker}")
        print()
    if any(e.kind == "simulator_wal" for e in entries):
        print("WAL sizes are estimates; checkpointing preserves database data, so actual savings may be smaller.")

    if args.all:
        if not entries:
            print("No DerivedData or worktree build folders found.")
            print(disk_line)
            return 0
        print(render_table(entries, now))
        print(f"\n{len(entries)} item(s), total {color(human_size(total_size(entries)), 'red')} "
              f"— {len(stale)} eligible ({color(human_size(total), 'red')})")
        print(disk_line)
    else:
        if not stale:
            print("Nothing to clean now.")
            print(disk_line)
            return 0
        print(render_table(stale, now, numbered=interactive))
        print(f"\n{len(stale)} item(s), total {color(human_size(total), 'red')}")
        print(disk_line)

    if not stale or args.dry_run:
        return 0

    selected = stale
    if not args.yes:
        if args.all:
            print()
            print(render_table(stale, now, numbered=True))
        try:
            ans = input(
                "Clean which? [a]ll / [n]one / e.g. 1,3,5-7 (default none): "
            ).strip().lower()
        except EOFError:
            ans = ""
        if ans in ("", "n", "no", "none"):
            print("Aborted.")
            return 0
        if ans not in ("a", "all", "y", "yes"):
            idx = parse_selection(ans, len(stale))
            if idx is None:
                print("Invalid selection. Aborted.")
                return 0
            selected = [stale[i] for i in sorted(idx)]
            if not selected:
                print("Nothing selected. Aborted.")
                return 0

    freed = delete_entries(selected, idle_minutes=args.idle_minutes if args.shutdown_idle or args.reset_idle else None)
    free_after, total_after = disk_usage()
    print(f"\nFreed {human_size(freed)}. Disk: {human_size(free_after)} free of {human_size(total_after)}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
